# Версия 2. Все пути к данным, картам и референсам задаются только здесь.
# Относительные пути считаются от корня проекта, НЕ от текущего каталога.
# Windows: SCURVE_NOISE_REFERENCE="C:\Users\Administrator\Desktop\MO testing\results\noise_test"
# Обратный слеш остается буквальным. r"..." здесь писать не надо.
# Пустое значение отключает необязательную ссылку. Для архивных ссылок используйте #.

# 1. Результаты новых тестов
RESULTS_DIR=results

# 2. Пороговые ЦАП, нужны аппаратным тестам
THRESHOLD_LUT_A=calibration/DAC_CMP_A.csv
THRESHOLD_LUT_B=calibration/DAC_CMP_B.csv
THRESHOLD_LUT_C=calibration/DAC_CMP_C.csv
THRESHOLD_LUT_D=calibration/DAC_CMP_D.csv

# 3. REF LUT, используются только при REFERENCE.mode="lut"
REF_LUT_1=calibration/REF1.csv
REF_LUT_2=calibration/REF2.csv

# 4. Необязательные исходные карты аппаратного теста
BASE_PIXEL_CONFIG=
BAD_PIXEL_MASK=
# Используется ТОЛЬКО при SCURVE.gain_source="csv"
GAIN_MAP_CSV=

# 5. S-кривые / GAIN-свип / crosstalk: завершенный noise+trim эксперимент
# Один источник для скалярного GAIN и для списка GAIN. Full-тест эту ссылку не использует.
SCURVE_NOISE_REFERENCE=
# SCURVE_NOISE_REFERENCE="C:\tests\results\old_noise_reference"

# 6. Clock noise: только сохраненные comparator trims, не старый noise
CLOCK_TRIM_REFERENCE=

# 7. GAIN equalization: завершенный S-свип, ALL или его analysis/vNNN
GAIN_SWEEP_SOURCE=

# 8. Повторный анализ и dashboard: эксперимент / ALL / noise_statistics.csv
OFFLINE_SOURCE=

# 9. Продолжение прерванного v2 теста. Не noise reference!
# Эти ссылки активируются ТОЛЬКО при RUN.resume=True
RESUME_EXPERIMENT=
EO_SWEEP_RESUME=
